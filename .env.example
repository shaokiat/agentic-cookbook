# Model Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Default Model
DEFAULT_MODEL=openai/gpt-4o
# DEFAULT_MODEL=anthropic/claude-3-5-sonnet-20240620

# Optional: LiteLLM Configuration
LITELLM_LOG=DEBUG

# --- Self-hosted inference (see deploy/vllm/ and examples/07_inference/) ------
# One local endpoint, one engine at a time: `make serve-vllm` / `serve-mlx` / `serve-ollama`
# all listen here, and the benchmark harness detects which engine answers.
# LOCAL_API_BASE=http://localhost:8000/v1
# LOCAL_API_KEY=cookbook-local
# Only needed for Ollama, and only when several models are pulled and none is loaded:
# Ollama's /v1/models lists its whole store rather than what it is serving.
# LOCAL_MODEL=qwen3:0.6b

# The Streamlit sidebar model picker is separate — litellm resolves those model strings
# against its own provider vars, so set the pair matching whichever engine is running.
# HOSTED_VLLM_API_BASE=http://localhost:8000/v1
# HOSTED_VLLM_API_KEY=cookbook-local
# VLLM_MODEL=Qwen3-0.6B-4bit
# OLLAMA_API_BASE=http://localhost:8000
# OLLAMA_MODEL=qwen3:0.6b
