# Required
LLM_API_KEY=fw_...

# Optional overrides (defaults target Fireworks' gpt-oss-120b)
# LLM_API_BASE=https://api.fireworks.ai/inference/v1
# LLM_MODEL=accounts/fireworks/models/gpt-oss-120b

# Any OpenAI-compatible endpoint works, including a local server started with
# `make serve-vllm` / `serve-mlx` / `serve-ollama` from the cookbook root:
# LLM_API_BASE=http://localhost:8000/v1
# LLM_API_KEY=cookbook-local
